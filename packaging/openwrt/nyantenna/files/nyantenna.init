#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

PROG=/usr/bin/nyantenna
CONFIG=/etc/nyantenna/config.yaml
WORKDIR=/var/lib/nyantenna

start_service() {
	mkdir -p "$WORKDIR/data" "$WORKDIR/logs"

	procd_open_instance
	# 必须自己 cd：数据库与日志路径（data/nyantenna.db、logs/app.log）都是相对工作目录的，
	# 而 procd 并没有 cwd 这个参数——写了会被静默忽略，进程以 / 为工作目录启动，
	# 于是去开 /data/nyantenna.db，目录不存在，SQLite 报 CANTOPEN(14)。
	# exec 让 sh 被替换掉，procd 仍能正确跟踪进程与 respawn。
	procd_set_param command /bin/sh -c "cd '$WORKDIR' && exec '$PROG' -c '$CONFIG'"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file "$CONFIG"
	procd_set_param limits core="0"
	procd_set_param env HOME="$WORKDIR"
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger nyantenna
}
