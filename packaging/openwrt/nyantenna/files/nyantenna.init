#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

PROG=/usr/bin/nyantenna
CONFIG=/etc/nyantenna/config.yaml

WORKDIR=/etc/nyantenna

LOGDIR=/var/log/nyantenna

LAUNCHER_DIR=/var/run/nyantenna
LAUNCHER="$LAUNCHER_DIR/nyantenna"

start_service() {
	mkdir -p "$WORKDIR/data" "$LOGDIR" "$LAUNCHER_DIR"

	[ -L "$WORKDIR/logs" ] || {
		rm -rf "$WORKDIR/logs"
		ln -s "$LOGDIR" "$WORKDIR/logs"
	}

	# 从旧的 tmpfs 位置迁移一次数据。
	if [ ! -f "$WORKDIR/data/nyantenna.db" ] && [ ! -f "$WORKDIR/data/vohive.db" ] &&
		[ -d /var/lib/nyantenna/data ]; then
		cp -a /var/lib/nyantenna/data/. "$WORKDIR/data/" 2>/dev/null
	fi

	cat >"$LAUNCHER" <<EOF
#!/bin/sh
cd '$WORKDIR' || exit 1
exec '$PROG' -c '$CONFIG'
EOF
	chmod +x "$LAUNCHER"

	procd_open_instance
	procd_set_param command "$LAUNCHER"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file "$CONFIG"
	procd_set_param limits core="0"
	procd_set_param env HOME="$WORKDIR"
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger nyantenna
}
